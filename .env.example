# ============================================================
# AI Paimon — Environment Variables
# Copy this file to `.env` and fill in your actual values.
# ============================================================

# --- OpenClaw (ClawBot) Gateway ---
# Gateway token from `openclaw.json`
OPENCLAW_TOKEN=your_openclaw_gateway_token_here

# Device credentials (from `openclaw device list`)
OPENCLAW_DEVICE_ID=your_device_id_here
OPENCLAW_DEVICE_TOKEN=your_device_token_here

# Ed25519 private key (PEM format, newlines replaced with \n)
# Example: -----BEGIN PRIVATE KEY-----\nMC4CAQ...base64...\n-----END PRIVATE KEY-----\n
OPENCLAW_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n

# --- VITS TTS Server ---
# Path to the Paimon VITS model checkpoint (.pth file)
VITS_MODEL_PATH=./paimon.pth

# Path to the VITS config JSON
VITS_CONFIG_PATH=./src/vits_server/VITS/configs/biaobei_base.json

# VITS server port
VITS_PORT=8020

# --- OpenClaw Gateway ---
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_SESSION=agent:main:main

# --- Open-LLM-VTuber ---
# Absolute path to your Open-LLM-VTuber installation
OPEN_LLM_VTUBER_DIR=C:\path\to\Open-LLM-VTuber
